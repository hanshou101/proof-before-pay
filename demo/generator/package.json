{
  "name": "@pbp/demo-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic generator for the Proof Before Pay demo inbox: 9 email JSON files, 7 invoice PDFs in three layouts, and the historical invoice copy.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "generate": "tsx src/generate.ts",
    "proof": "tsx src/proof.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "unpdf": "1.7.0"
  }
}
