# 只写键名，不写值。真实值放 .env（不提交）。
# SPEC §6.9：空值等同未设定（AGENTS 坑 A1）——照抄本文件、只填你能填的，服务照样起得来。

# PayPal 沙箱 REST app（developer.paypal.com → Sandbox → Apps & Credentials）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 只接受 sandbox；别的值会在开跑前被拒，不会发出任何请求。
PAYPAL_ENV=

# 任一 OpenAI 相容的 Chat Completions 端点（SPEC §6.6.1），默认 DeepSeek。
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 账本、history.json、模型原始输出的目录（默认仓库根 data/，不进 Git）。
PBP_DATA_DIR=

# 沙箱收款人对账表，JSON：vendorId → 沙箱电邮（SPEC §6.5.5）。
PBP_RECEIVER_MAP=

# 对照模式默认关闭；设 1 才会接受 POST /api/runs {mode:"comparison"}（AC-14）。
PBP_ALLOW_COMPARISON=

# 故障注入，只在测试与演示用（SPEC §6.5.4）：drop_after_submit[:first|:<intentId>]
PBP_FAULT=

# API 端口（默认 8787）。网页一律从 5173 进，它把 /api 转过来。
PORT=
